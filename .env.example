# Local Compose only. Generate a password (hex avoids URL escaping): openssl rand -hex 24
POSTGRES_USER=claps
POSTGRES_DB=claps
POSTGRES_PASSWORD=replace-with-generated-hex
# Compose services connect to the internal db hostname. No public DB port.
DATABASE_URL=postgresql://claps:replace-with-generated-hex@db:5432/claps
WEB_PORT=3000
# Only compose.test.yaml exposes a loopback test port; dedicated DB + volume.
TEST_DATABASE_URL=postgresql://claps_test:claps_test_local_only@127.0.0.1:55433/claps_test
DB_POOL_MAX=10
WORKER_HEARTBEAT_PATH=/tmp/claps-worker-heartbeat
# Mail, auth and external provider secrets are introduced in their owning Phases.

# Public browser origin for locale mutation Origin checks, including proxy deployments.
APP_ORIGIN=http://localhost:3000

# Explicit development-only mail delivery. Keep this directory outside public/.next/app.
MAIL_ADAPTER=sandbox
MAIL_SANDBOX_DIR=/tmp/claps-mail
# Set ONLY when the trusted reverse proxy overwrites this header on every request.
# AUTH_TRUSTED_IP_HEADER=x-real-ip

# Private shared persistent file storage; never place under public/.
UPLOADS_DIR=/app/uploads
# Cover uploads: 10 MiB body maximum; configure any ingress limit to the same value.

# Phase 5 jobs: PostgreSQL queue; worker consumes only explicitly registered real handlers.
# Approved development policy in lib/server/jobs/policy.ts: per owner 2 running,
# 10 queued, 60 new attempts/hour, 5 min timeout, 2 safe retries, 30s lease.
# Unknown provider responses NEVER retry automatically. No production test adapter switch.
# Storage maintenance removes expired download capabilities only; physical deletion is disabled.

# Phase 11: backups need both DB and UPLOADS_DIR from the same stopped-write point.
# scripts/backup-restore.py takes an explicit Compose project/env file/directory.
# Recovery uses a separate empty DB + uploads volume; never run migrations before restore.
# Off-host backup schedule, retention, encryption, RPO/RTO and public TLS remain deployment decisions.
