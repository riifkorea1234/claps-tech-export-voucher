{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --conditions=react-server --import tsx scripts/db.ts migrate",
    "db:seed": "node --conditions=react-server --import tsx scripts/db.ts seed",
    "worker": "node --conditions=react-server --import tsx workers/index.ts",
    "worker:health": "node scripts/worker-health.mjs",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:i18n": "vitest run --project i18n",
    "test:e2e": "playwright test",
    "test:db:up": "docker compose -f compose.test.yaml up -d --wait",
    "test:db:stop": "docker compose -f compose.test.yaml stop",
    "i18n:activate": "node --conditions=react-server --import tsx scripts/activate-locales.ts",
    "account": "node --conditions=react-server --import tsx scripts/account.ts",
    "db:seed:demo": "node --conditions=react-server --import tsx scripts/seed-demo.ts",
    "test:demo": "playwright test --config playwright.demo.config.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "@next/env": "16.3.3",
    "@phosphor-icons/react": "^2.1.10",
    "@tabler/icons-react": "^3.46.0",
    "better-auth": "1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "pg": "8.23.0",
    "pretendard": "^1.3.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "shadcn": "^4.19.0",
    "sharp": "0.35.3",
    "tailwind-merge": "^3.6.0",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "22.20.4",
    "@types/pg": "8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "22.22.0",
    "pnpm": "10.34.5"
  }
}
