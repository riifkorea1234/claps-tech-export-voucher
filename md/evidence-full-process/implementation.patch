+    const report={at:new Date().toISOString(),target:process.env.APP_ORIGIN,accountStates,counts,jobs,fileChecks,pendingJobs:pending,allStoredFilesValid:fileChecks.every(f=>f.checksumMatch&&f.sizeMatch)};
